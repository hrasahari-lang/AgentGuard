# Copy to .env for local development. Never commit .env or real secrets.
APP_ENV=development
AGENTGUARD_DB_PATH=backend/data/agentguard.db
AGENTGUARD_HOST=127.0.0.1
AGENTGUARD_PORT=8000
# Comma-separated exact browser origins. Production must set only its approved frontend origin.
AGENTGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Exact Host names accepted by the MCP server; loopback development hosts remain allowed.
AGENTGUARD_MCP_SERVER_ALLOWED_HOSTS=agentguard-api-g87x.onrender.com
# Outbound remote MCP servers approved for demo clients; this is separate from the server's inbound Host allowlist.
AGENTGUARD_TRUSTED_MCP_HOSTS=
# Apply before credential lookup to every request, including valid credentials.
AGENTGUARD_AUTH_REQUEST_LIMIT=300
# Limit sanitized authentication-failure records per transport peer per 60 seconds.
AGENTGUARD_AUTH_FAILURE_LIMIT=20
AGENTGUARD_AUTH_FAILURE_WINDOW_SECONDS=60
AGENTGUARD_AUTH_FAILURE_MAX_CLIENTS=4096
# Keep only the latest 10,000 sanitized authentication failures in their dedicated table.
AGENTGUARD_AUTH_FAILURE_RETENTION=10000
# Agent credentials are generated by `python -m backend.app.provision_agent issue`.
# Raw tokens are never stored in this file or in the database.
# Optional production bootstrap: configure both secrets together in the host environment.
# They bootstrap agent_admin and agent_sales_1 and are stored in SQLite only as SHA-256 hashes.
# AGENTGUARD_BOOTSTRAP_ADMIN_TOKEN=
# AGENTGUARD_BOOTSTRAP_DEMO_AGENT_TOKEN=
