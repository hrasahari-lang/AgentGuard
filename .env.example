# Copy to .env for local development. Never commit .env or real secrets.
APP_ENV=development
AGENTGUARD_DB_PATH=backend/data/agentguard.db
AGENTGUARD_HOST=127.0.0.1
AGENTGUARD_PORT=8000
# Local process limit: at most 20 failed authentication requests per transport peer per 60 seconds.
AGENTGUARD_AUTH_FAILURE_LIMIT=20
AGENTGUARD_AUTH_FAILURE_WINDOW_SECONDS=60
AGENTGUARD_AUTH_FAILURE_MAX_CLIENTS=4096
# Keep only the latest 10,000 sanitized authentication failures in their dedicated table.
AGENTGUARD_AUTH_FAILURE_RETENTION=10000
# Agent credentials are generated by `python -m backend.app.provision_agent issue`.
# Raw tokens are never stored in this file or in the database.
